{
  "framework": "nextjs",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "crons": [
    {
      "path": "/api/cron/keep-warm",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/meeting-reminders",
      "schedule": "45 16 * * *"
    },
    {
      "path": "/api/cron/meeting-reminders",
      "schedule": "45 17 * * *"
    },
    {
      "path": "/api/cron/telnyx-recordings-backfill",
      "schedule": "15 3 * * *"
    },
    {
      "path": "/api/cron/telnyx-recordings-backfill?hours=6",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/sync-podio-outcomes",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/cron/sync-allio-native-occupancy",
      "schedule": "0 * * * *"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "scripts-og-traening": false
    }
  }
}
